@model List<WorkerServiceControlWeb.Models.AppUser>

@{
    ViewData["Title"] = "Administration des accès";
    var currentUsername = User.Identity?.Name;
    var totalUsers = Model.Count;
    var adminUsers = Model.Count(user => string.Equals(user.Role, "Admin", StringComparison.OrdinalIgnoreCase));
    var standardUsers = totalUsers - adminUsers;
    var frenchCulture = new System.Globalization.CultureInfo("fr-FR");
}

<div class="app-shell admin-page">
    <nav class="page-breadcrumb" aria-label="Fil d’Ariane">
        <a class="back-link" asp-controller="Worker" asp-action="Index">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>Centre de supervision</span>
        </a>
    </nav>

    <header class="page-header page-header-split">
        <div class="page-header-content">
            <p class="page-eyebrow">Administration</p>
            <h1>Comptes et accès</h1>
            <p>Gérez les identités, les fonctions et les niveaux d’autorisation de FlowOps.</p>
        </div>
        <div class="page-header-badge">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 3l8 4v5c0 4.7-3.2 7.5-8 9-4.8-1.5-8-4.3-8-9V7l8-4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>Espace administrateur</span>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(ViewBag.Message as string))
    {
        <div class="admin-alert admin-alert-ok" role="status">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7" />
                <path d="M8 12l2.5 2.5L16 9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>@ViewBag.Message</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(ViewBag.Error as string))
    {
        <div class="admin-alert admin-alert-error" role="alert">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7" />
                <path d="M12 8v5M12 16.5h.01" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
            </svg>
            <span>@ViewBag.Error</span>
        </div>
    }

    <section class="summary-grid admin-summary-grid" aria-label="Synthèse des comptes">
        <article class="summary-card surface-card">
            <span class="summary-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M8.5 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM17 8h6M20 5v6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
            <span class="summary-content">
                <span class="summary-label">Comptes enregistrés</span>
                <strong class="summary-value">@totalUsers</strong>
                <span class="summary-meta">Accès configurés dans FlowOps</span>
            </span>
        </article>

        <article class="summary-card surface-card">
            <span class="summary-icon summary-icon-admin" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3l8 4v5c0 4.7-3.2 7.5-8 9-4.8-1.5-8-4.3-8-9V7l8-4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                    <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
            <span class="summary-content">
                <span class="summary-label">Administrateurs</span>
                <strong class="summary-value">@adminUsers</strong>
                <span class="summary-meta">Comptes avec gestion des accès</span>
            </span>
        </article>

        <article class="summary-card surface-card">
            <span class="summary-icon summary-icon-user" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.7" />
                    <path d="M4 21a8 8 0 0 1 16 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                </svg>
            </span>
            <span class="summary-content">
                <span class="summary-label">Utilisateurs</span>
                <strong class="summary-value">@standardUsers</strong>
                <span class="summary-meta">Comptes de supervision standard</span>
            </span>
        </article>
    </section>

    <section class="surface-card admin-directory-card" aria-labelledby="accountDirectoryTitle">
        <div class="panel-header admin-directory-header">
            <div>
                <p class="panel-eyebrow">Répertoire</p>
                <h2 id="accountDirectoryTitle" class="panel-title">Utilisateurs FlowOps</h2>
                <p class="panel-copy">Vérifiez les informations de compte avant de modifier un accès.</p>
            </div>
            <span class="panel-count">@totalUsers @(totalUsers > 1 ? "comptes" : "compte")</span>
        </div>

        <div class="data-table-wrap">
            <table class="admin-users-table data-table">
                <caption class="visually-hidden">Liste des utilisateurs et de leurs niveaux d’accès</caption>
                <thead>
                    <tr>
                        <th scope="col">Compte</th>
                        <th scope="col">Accès</th>
                        <th scope="col">Fonction</th>
                        <th scope="col">Membre depuis</th>
                        <th scope="col" class="data-table-actions-heading"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var userDisplayName = string.IsNullOrWhiteSpace(user.DisplayName) ? user.Username : user.DisplayName;
                        var userInitials = string.Join("", userDisplayName
                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Take(2)
                            .Select(part => char.ToUpperInvariant(part[0])));

                        if (string.IsNullOrEmpty(userInitials))
                        {
                            userInitials = "FO";
                        }

                        var isCurrentUser = string.Equals(user.Username, currentUsername, StringComparison.OrdinalIgnoreCase);
                        var memberSinceIso = user.MemberSince.ToString("yyyy-MM-dd");

                        <tr>
                            <td>
                                <div class="user-cell">
                                    <span class="user-avatar" aria-hidden="true">@userInitials</span>
                                    <span class="user-cell-copy">
                                        <strong class="user-display-name">@userDisplayName</strong>
                                        <span class="user-handle">@("@" + user.Username)</span>
                                    </span>
                                    @if (isCurrentUser)
                                    {
                                        <span class="admin-you-badge">Vous</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="role-badge @(string.Equals(user.Role, "Admin", StringComparison.OrdinalIgnoreCase) ? "role-badge-admin" : "role-badge-user")">
                                    @(string.Equals(user.Role, "Admin", StringComparison.OrdinalIgnoreCase) ? "Administrateur" : "Utilisateur")
                                </span>
                            </td>
                            <td>
                                <span class="table-primary-text">@(string.IsNullOrWhiteSpace(user.JobTitle) ? "Non renseignée" : user.JobTitle)</span>
                            </td>
                            <td>
                                <time datetime="@memberSinceIso">@user.MemberSince.ToString("dd MMMM yyyy", frenchCulture)</time>
                            </td>
                            <td class="data-table-actions-cell">
                                <div class="table-actions">
                                    <a class="table-action table-action-primary"
                                       asp-controller="Admin"
                                       asp-action="EditUser"
                                       asp-route-username="@user.Username"
                                       aria-label="Modifier le compte de @userDisplayName">
                                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M13.5 6.5l4 4M4 20l4.5-1 10-10a2.8 2.8 0 0 0-4-4l-10 10L4 20z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                        <span>Modifier</span>
                                    </a>
                                    <form method="post"
                                          asp-controller="Admin"
                                          asp-action="DeleteUser"
                                          class="table-action-form"
                                          onsubmit="return confirm('Supprimer définitivement l\'utilisateur &quot;@user.Username&quot; ?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="username" value="@user.Username" />
                                        <button type="submit"
                                                class="table-action table-action-danger"
                                                aria-label="Supprimer le compte de @userDisplayName">
                                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M4 7h16M9 7V5h6v2M7 7l1 13h8l1-13M10 11v5M14 11v5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                            <span>Supprimer</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
