@model ErrorViewModel

@{
    ViewData["Title"] = "Action interrompue";
}

<div class="app-shell error-page">
    <section class="surface-card error-state" aria-labelledby="errorTitle">
        <div class="error-state-visual" aria-hidden="true">
            <span class="error-state-code">!</span>
            <span class="error-state-orbit error-state-orbit-one"></span>
            <span class="error-state-orbit error-state-orbit-two"></span>
        </div>

        <div class="error-state-content">
            <p class="page-eyebrow">Action interrompue</p>
            <h1 id="errorTitle">FlowOps n’a pas pu terminer cette demande.</h1>
            <p>Une erreur inattendue s’est produite. Vos services continuent de fonctionner indépendamment de cette page.</p>

            <div class="error-state-actions">
                <a class="btn-app-primary error-primary-action" asp-controller="Worker" asp-action="Index">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.7" />
                        <rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.7" />
                        <rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.7" />
                        <rect x="14" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.7" />
                    </svg>
                    <span>Retour à la supervision</span>
                </a>
                <a class="secondary-action" asp-controller="Home" asp-action="Index">Ouvrir l’accueil FlowOps</a>
            </div>

            <div class="error-guidance">
                <span class="error-guidance-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7" />
                        <path d="M12 11v5M12 8h.01" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                    </svg>
                </span>
                <p>Si le problème persiste, transmettez la référence ci-dessous à l’administrateur de la plateforme.</p>
            </div>

            @if (Model.ShowRequestId)
            {
                <div class="error-reference">
                    <span>Référence technique</span>
                    <code>@Model.RequestId</code>
                </div>
            }
        </div>
    </section>
</div>
