@{
    ViewData["Title"] = "Mon profil";

    var username = User.Identity?.Name ?? "Utilisateur";
    var displayNameClaim = User.FindFirst("DisplayName")?.Value;
    var displayName = string.IsNullOrWhiteSpace(displayNameClaim) ? username : displayNameClaim;
    var jobTitle = User.FindFirst("JobTitle")?.Value ?? "";
    var accessLabel = User.IsInRole("Admin") ? "Administrateur" : "Utilisateur";
    var memberSinceClaim = User.FindFirst("MemberSince")?.Value;
    DateTime? memberSince = null;

    if (DateTime.TryParse(memberSinceClaim, out var parsedMemberSince))
    {
        memberSince = parsedMemberSince;
    }

    var initials = string.Join("", displayName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));

    if (string.IsNullOrEmpty(initials))
    {
        initials = "FO";
    }

    var memberSinceLabel = memberSince?.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("fr-FR")) ?? "Non renseignée";
}

<div class="app-shell profile-page">
    <nav class="page-breadcrumb" aria-label="Fil d’Ariane">
        <a class="back-link" asp-controller="Worker" asp-action="Index">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>Centre de supervision</span>
        </a>
    </nav>

    <header class="page-header page-header-split">
        <div class="page-header-content">
            <p class="page-eyebrow">Compte et accès</p>
            <h1>Mon profil</h1>
            <p>Consultez les informations utilisées pour personnaliser votre espace FlowOps.</p>
        </div>
        <span class="role-badge @(User.IsInRole("Admin") ? "role-badge-admin" : "role-badge-user")">@accessLabel</span>
    </header>

    <section class="profile-layout" aria-label="Informations du profil">
        <article class="surface-card profile-identity-card">
            <div class="profile-identity-header">
                <span class="profile-avatar-large" aria-hidden="true">@initials</span>
                <div class="profile-identity-copy">
                    <p class="profile-card-eyebrow">Identité</p>
                    <h2>@displayName</h2>
                    <p>@(string.IsNullOrWhiteSpace(jobTitle) ? "Fonction non renseignée" : jobTitle)</p>
                </div>
            </div>

            <dl class="profile-detail-list">
                <div class="profile-detail-row">
                    <dt>Nom d’utilisateur</dt>
                    <dd>@username</dd>
                </div>
                <div class="profile-detail-row">
                    <dt>Niveau d’accès</dt>
                    <dd>@accessLabel</dd>
                </div>
                <div class="profile-detail-row">
                    <dt>Membre depuis</dt>
                    <dd>@memberSinceLabel</dd>
                </div>
            </dl>
        </article>

        <div class="profile-main-column">
            <div class="summary-grid profile-summary-grid">
                <article class="summary-card surface-card">
                    <span class="summary-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 3l8 4v5c0 4.7-3.2 7.5-8 9-4.8-1.5-8-4.3-8-9V7l8-4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                            <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    <span class="summary-content">
                        <span class="summary-label">Accès</span>
                        <strong class="summary-value">@accessLabel</strong>
                    </span>
                </article>

                <article class="summary-card surface-card">
                    <span class="summary-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="4" y="6" width="16" height="13" rx="2" stroke="currentColor" stroke-width="1.7" />
                            <path d="M9 6V4h6v2M4 11h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                        </svg>
                    </span>
                    <span class="summary-content">
                        <span class="summary-label">Fonction</span>
                        <strong class="summary-value">@(string.IsNullOrWhiteSpace(jobTitle) ? "Non renseignée" : jobTitle)</strong>
                    </span>
                </article>

                <article class="summary-card surface-card">
                    <span class="summary-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="4" y="5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.7" />
                            <path d="M8 3v4M16 3v4M4 10h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                        </svg>
                    </span>
                    <span class="summary-content">
                        <span class="summary-label">Inscription</span>
                        <strong class="summary-value">@memberSinceLabel</strong>
                    </span>
                </article>
            </div>

            <article class="surface-card quick-access-card">
                <div class="panel-header">
                    <div>
                        <p class="panel-eyebrow">Accès rapides</p>
                        <h2 class="panel-title">Reprendre vos opérations</h2>
                        <p class="panel-copy">Retrouvez directement les espaces utiles à votre activité.</p>
                    </div>
                </div>

                <div class="quick-link-list">
                    <a class="quick-link" asp-controller="Worker" asp-action="Index">
                        <span class="quick-link-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.7" />
                                <rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.7" />
                                <rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.7" />
                                <rect x="14" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.7" />
                            </svg>
                        </span>
                        <span>
                            <strong>Supervision des services</strong>
                            <small>Consulter l’état et accéder aux commandes.</small>
                        </span>
                        <svg class="quick-link-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>

                    <a class="quick-link" asp-controller="Worker" asp-action="Files">
                        <span class="quick-link-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                            </svg>
                        </span>
                        <span>
                            <strong>Fichiers des services</strong>
                            <small>Explorer les fichiers disponibles par service.</small>
                        </span>
                        <svg class="quick-link-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a class="quick-link" asp-controller="Admin" asp-action="Dashboard">
                            <span class="quick-link-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM19 8v6M22 11h-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span>
                                <strong>Administration</strong>
                                <small>Gérer les comptes et leurs niveaux d’accès.</small>
                            </span>
                            <svg class="quick-link-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    }
                </div>
            </article>
        </div>
    </section>
</div>
